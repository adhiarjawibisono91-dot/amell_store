@charset "utf-8";

* { font-family: Poppins, sans-serif; }

body { background-color: rgb(240, 249, 255); min-height: 100vh; }

.navbar-custom { background: linear-gradient(135deg, rgb(2, 132, 199) 0%, rgb(56, 189, 248) 100%); box-shadow: rgba(56, 189, 248, 0.25) 0px 4px 20px; }

.live-banner-btn { background: linear-gradient(135deg, rgb(239, 68, 68) 0%, rgb(244, 63, 94) 100%); color: white; font-weight: 700; border-radius: 30px; padding: 8px 18px; box-shadow: rgba(239, 68, 68, 0.4) 0px 4px 15px; animation: 1.8s ease 0s infinite normal none running pulseLive; text-decoration: none; display: inline-flex; align-items: center; }

.live-banner-btn:hover { color: white; transform: scale(1.03); }

@keyframes pulseLive { 
  0% { box-shadow: rgba(239, 68, 68, 0.6) 0px 0px 0px 0px; }
  70% { box-shadow: rgba(239, 68, 68, 0) 0px 0px 0px 12px; }
  100% { box-shadow: rgba(239, 68, 68, 0) 0px 0px 0px 0px; }
}

.hero-banner { background: linear-gradient(135deg, rgb(2, 132, 199) 0%, rgb(56, 189, 248) 50%, rgb(125, 211, 252) 100%); color: white; border-radius: 20px; padding: 30px; box-shadow: rgba(56, 189, 248, 0.3) 0px 10px 30px; margin-bottom: 30px; }

.card-product { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 18px; background: rgb(255, 255, 255); box-shadow: rgba(186, 230, 253, 0.4) 0px 8px 24px; transition: 0.3s; height: 100%; display: flex; flex-direction: column; overflow: hidden; position: relative; }

.card-product:hover { transform: translateY(-6px); box-shadow: rgba(56, 189, 248, 0.3) 0px 14px 30px; }

.product-img-box { width: 100%; height: 200px; background-color: rgb(248, 250, 252); position: relative; overflow: hidden; }

.product-img-box img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }

.card-product:hover .product-img-box img { transform: scale(1.08); }

.badge-discount { position: absolute; top: 10px; left: 10px; background: rgb(239, 68, 68); color: white; font-weight: 700; font-size: 0.75rem; padding: 4px 8px; border-radius: 8px; z-index: 2; }

.badge-bogo { background: linear-gradient(135deg, rgb(255, 65, 108) 0%, rgb(255, 75, 43) 100%); color: white; font-size: 0.7rem; font-weight: 600; padding: 4px 8px; border-radius: 12px; }

.badge-star { background-color: rgb(254, 243, 199); color: rgb(217, 119, 6); font-weight: 600; font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; }

.btn-soft-blue { background: linear-gradient(135deg, rgb(2, 132, 199) 0%, rgb(56, 189, 248) 100%); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 12px; padding: 10px 18px; font-weight: 600; transition: 0.3s; box-shadow: rgba(2, 132, 199, 0.25) 0px 4px 12px; width: 100%; }

.btn-soft-blue:hover { background: linear-gradient(135deg, rgb(3, 105, 161) 0%, rgb(2, 132, 199) 100%); color: white; }

.cart-badge { background-color: rgb(239, 68, 68); color: white; border-radius: 50%; padding: 2px 7px; font-size: 0.75rem; font-weight: 700; vertical-align: top; margin-left: -5px; }

.category-pill { background-color: rgb(255, 255, 255); color: rgb(2, 132, 199); border: 1.5px solid rgb(186, 230, 253); border-radius: 20px; padding: 8px 18px; font-weight: 500; text-decoration: none; transition: 0.2s; display: inline-block; }

.category-pill:hover, .category-pill.active { background-color: rgb(2, 132, 199); color: white; border-color: rgb(2, 132, 199); }

.pwa-install-btn { background: linear-gradient(135deg, rgb(16, 185, 129) 0%, rgb(5, 150, 105) 100%); color: white; font-weight: 600; border-radius: 30px; padding: 8px 18px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; box-shadow: rgba(16, 185, 129, 0.3) 0px 4px 14px; transition: 0.2s; }

.pwa-install-btn:hover { transform: translateY(-2px); color: white; }
